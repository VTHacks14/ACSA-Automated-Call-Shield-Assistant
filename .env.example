# ACSA — environment variables template
#
# Copy this file to `.env` (same folder) and fill in real values there.
# `.env` itself is gitignored and must NEVER be committed — this file
# (.env.example) is the one that's safe to commit, since it has no
# real secrets in it.

# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Number 1: ACSA's real line (E.164, e.g. +15405550100). Used by the red-demo script as the call target.
TWILIO_NUMBER_1=+1XXXXXXXXXX
# Number 2: internal-only, places the red-demo call into Number 1.
TWILIO_NUMBER_2=+1XXXXXXXXXX

# --- Public URL of this backend (your current ngrok https URL, no trailing slash) ---
# Twilio needs absolute URLs for <Play>; ngrok's free tier changes this every restart.
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# --- Layer 1: MongoDB Atlas (free tier) ---
# Leave unset to skip the number gate (it logs a warning and treats every number as "no match").
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=acsa

# --- Layer 3: Sightengine (dashboard.sightengine.com -> API Keys) ---
SIGHTENGINE_API_USER=your_sightengine_api_user_here
SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here

# --- Gemini verdict (aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (default set in pipeline/gemini_reasoning.py)
# GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs (TTS for ACSA's greeting only; there is no ElevenLabs detection API) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: pick a different voice (default is a stock premade voice)
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Optional tuning (defaults live in the pipeline modules) ---
# ACSA_ANSWER_TIMEOUT_SECONDS=20      # how long a ringing call waits for Yes/No before ACSA auto-answers
# ACSA_FORWARD_TO_NUMBER=+1XXXXXXXXXX # where "No" rings the call through to (unset = polite decline message)
# SPEAKER_MISMATCH_BELOW=0.80         # raw cosine under which Layer 2 calls a mismatch (measured on 8 kHz calls: same speaker .87-.93, different .73-.76)
# SPEAKER_MATCH_ABOVE=0.85            # raw cosine at/above which Layer 2 calls a match (proceeds; not a green light)
# SIGHTENGINE_AI_ABOVE=0.85           # ai_speech score at/above which Layer 3 is "confident AI"
# SIGHTENGINE_HUMAN_BELOW=0.15        # ai_speech score at/below which Layer 3 is "confident human"
# LOCAL_DETECTOR_ENABLED=0            # Layer 4 is OFF by default: uncalibrated on 8 kHz phone audio (false-flagged a real caller). See pipeline/local_detector.py
# LOCAL_DETECTOR_AI_ABOVE=0.95        # Layer 4 is a weaker detector, so its bar for "confident AI" is higher
